---
import Layout from "../components/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import { boardMembers } from "../data/board";
---

<Layout title="Meet the Board">
  <PageBanner slot="banner" title="Meet the Board">
    <span slot="box">
      Our board of trustees volunteer their time and experience to guide
      Refuweegee's work and make sure we stay true to our aim.
    </span>
  </PageBanner>
  <main class="max-w-7xl mx-auto pt-6 lg:pt-12">
    <div class="mb-8">
      <h2 class="text-4xl text-weegee-teal tracking-tight font-bold">
        Our trustees
      </h2>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {boardMembers.map((member) => (
        <li class="bg-weegee-white border-2 border-weegee-black rounded-xl p-6 md:p-8 flex flex-col transition-all duration-300 hover:shadow-xl">
          <h3 class="text-2xl text-weegee-black font-bold tracking-tight mb-1">
            {member.name}
          </h3>

          {member.role && (
            <span
              class={`self-start inline-block text-xs uppercase tracking-wider font-bold px-3 pt-1.5 pb-2 rounded-full ${member.accent} mb-4`}
            >
              {member.role}
            </span>
          )}

          <p class="text-sm text-weegee-black font-sans font-light leading-relaxed">
            {member.bio}
          </p>
        </li>
      ))}
    </ul>
  </main>
</Layout>
