---
import Layout from "../components/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import { teamMembers } from "../data/team";
---

<Layout title="Meet the Team">
  <PageBanner slot="banner" title="Meet the team">
    <span slot="box">
      The Refuweegee team is made up of 16 core team members. Find out a bit more about them.
    </span>
  </PageBanner>
  <main class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
      {teamMembers.map((member) => (
        <div class="bg-weegee-white border-2 border-weegee-black rounded-xl overflow-hidden flex flex-col justify-between group transition-all duration-300 hover:shadow-xl">
          <!-- Image frame with crisp padding -->
          <div class="p-3 w-full aspect-square">
            <div class="w-full h-full bg-weegee-cream rounded-xl overflow-hidden border border-weegee-black/5 relative">
              <img
                src={member.image}
                alt={`${member.name} - ${member.role}`}
                class="w-full h-full aspect-square object-cover transition-all duration-500"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Profile Text Block -->
          <div class="px-6 pt-2 flex-1 flex flex-col justify-between">
            <div>
              <h2 class="text-2xl text-weegee-black font-bold tracking-tight mb-1">
                {member.name}
              </h2>

              <span
                class={`inline-block text-xs uppercase tracking-wider font-bold px-3 pt-1.5 pb-2 rounded-full ${member.accent} mb-4`}
              >
                {member.role}
              </span>

              <p class="text-sm text-weegee-black font-sans font-light leading-relaxed">
                {member.bio}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
